REFRESH_TOKEN_TTL=604800
ALLOW_REGISTRATION=false
CLIENT_URL=http://localhost:3000
FRONTEND_REVALIDATE_URL=http://localhost:3000/revalidate
REVALIDATE_SECRET=
CONTACT_WEBHOOK_URL=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Cloudinary (image uploads from the dashboard) — cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=axiom_agency
UPLOAD_MAX_MB=5
