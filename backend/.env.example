NODE_ENV=development
PORT=5000
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=axiom_agency
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
ALLOW_REGISTRATION=false
CLIENT_URL=http://localhost:3000
FRONTEND_REVALIDATE_URL=http://localhost:3000/revalidate
REVALIDATE_SECRET=
CONTACT_WEBHOOK_URL=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Cloudinary (image uploads from the dashboard) — cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=axiom_agency
UPLOAD_MAX_MB=5

# Email (Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS = 16-char Google "App password")
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Axiom Digital Studio <your-gmail@gmail.com>
# who gets an instant email for every new contact-form lead (comma-separated)
LEAD_NOTIFY_EMAILS=
