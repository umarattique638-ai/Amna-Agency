NODE_ENV=development
PORT=5000
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=axiom_agency
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
